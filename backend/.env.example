# LexGuard Backend Configuration
APP_ENV=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="LexGuard Backend"

# Maximum upload file size in Megabytes (Default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# Allowed CORS Origins (comma-separated, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Temporary File Storage Directory (ephemeral processing only)
TEMP_STORAGE_PATH=./tmp_uploads

# Gemini AI Engine Configuration (Primary with Automatic Fallback)
GEMINI_API_KEY_PRIMARY=your_primary_key_here
GEMINI_API_KEY_FALLBACK=your_fallback_key_here
# Legacy key (kept for backward compatibility, overridden if PRIMARY is set)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
MAX_ANALYSIS_CHAR_COUNT=150000

# Database Configuration (PostgreSQL + pgvector)
# Use postgresql+psycopg:// for async SQLAlchemy with psycopg3
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lexguard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Retrieval & Vector Store Configuration
EMBEDDING_DIMENSION=3072
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
CHUNK_TARGET_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=100
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_MIN_SCORE=0.55
